---
// frontend/src/pages/projects/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { fetchFromStrapi } from '../../lib/strapi';
import { marked } from 'marked';

export async function getStaticPaths() {
  try {
    const projects = await fetchFromStrapi({ endpoint: 'projects' });
    return projects.map((item: any) => {
      const project = item.attributes ? item.attributes : item;
      return {
        params: { slug: project.slug },
        props: { project },
      };
    });
  } catch (error) {
    console.error("Error generating paths for projects:", error);
    return [];
  }
}

const { project } = Astro.props;
const htmlContent = marked.parse(project.description || '');

const tagList = Array.isArray(project.tags)
  ? project.tags
  : typeof project.tags === 'string'
    ? project.tags.split(',').map((t: string) => t.trim())
    : [];
---

<Layout title={`${project.title} | Projects`}>
  <main class="flex-1 h-[calc(100vh-64px)] md:h-screen overflow-y-auto px-8 sm:px-16 md:px-24 py-16 md:py-24 bg-background scroll-smooth">
    <div class="max-w-2xl mx-auto">
      
      <div class="mb-14">
        <a 
          href="/projects" 
          class="font-sans text-[11px] font-bold tracking-widest text-foreground/40 hover:text-highlight uppercase transition-colors inline-flex items-center gap-2"
        >
          <span class="text-[10px] font-sans">‹‹‹</span> Back to Projects
        </a>
      </div>

      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-serif font-black text-foreground tracking-tight leading-tight mb-4">
          {project.title}
        </h1>

        {tagList.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tagList.map((tag: string) => (
              <span class="font-sans text-[10px] font-bold tracking-wider px-3 py-1 bg-foreground/[0.03] text-foreground/70 border border-foreground/10 uppercase">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      {project.image && (
        <div class="w-full aspect-[16/9] bg-foreground/5 border border-foreground/10 overflow-hidden mb-10">
          <img 
            src={typeof project.image === 'string' ? project.image : project.image?.data?.attributes?.url} 
            alt={project.title} 
            class="w-full h-full object-cover grayscale"
          />
        </div>
      )}

      <article class="font-serif text-foreground/90 text-justify space-y-6">
        <div set:html={htmlContent} />
      </article>

    </div>
  </main>
</Layout>

<style>
  /* Matches your beautiful blog subheadings exactly */
  article :global(h1) {
    font-family: Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.5rem;             
    font-weight: 900;              
    color: var(--color-foreground, #0c1618);
    letter-spacing: -0.025em;      
    margin-top: 2.5rem;              
    margin-bottom: 0.875rem;        
    display: block;
  }

  /* Matches your beautiful blog paragraph typography exactly */
  article :global(p) {
    font-size: 0.935rem;           
    line-height: 1.65;            
    margin-bottom: 1.25rem;        
    color: var(--color-foreground, #0c1618);
    opacity: 0.95;
  }
</style>
