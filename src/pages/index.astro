---
// frontend/src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { fetchFromStrapi } from '../lib/strapi';
import { marked } from 'marked';

// 1. Fetch Profile Data
let profile: any = { bio: "Intro: who I am..." };
try {
  // Pulling profile structure from your 'about-me' single-type endpoint
  const data = await fetchFromStrapi({ endpoint: 'about-me', query: '?populate=*' });
  console.log(data);
  if (data?.attributes) profile = data.attributes;
  else if (data) profile = data;
} catch (error) {
  console.error("Error loading profile details:", error);
}

// Convert rich-text biography Markdown to clean safe HTML markup
const htmlBio = marked.parse(profile.bio || '');

// Setup base url endpoint parameter to safely extract local system media images
const strapiBaseUrl = import.meta.env.STRAPI_URL || 'http://localhost:1337';

// SAFE DATA TARGETING: Target the media payload nested inside your profile object
const rawHeadshot = profile.headshot;
const relativeImageUrl = typeof rawHeadshot === 'string' 
  ? rawHeadshot 
  : rawHeadshot?.data?.attributes?.url || rawHeadshot?.url;

const absoluteImageUrl = relativeImageUrl ? `${strapiBaseUrl}${relativeImageUrl}` : null;

// 2. Fetch Curated/Recent Blog Posts
let featuredPosts = [];
try {
  // Pulling articles, sorting by newest, and limiting to 3 entries
  const posts = await fetchFromStrapi({ 
    endpoint: 'blogs',
    query: '?_sort=publishedAt:DESC&_limit=3' 
  });
  featuredPosts = posts.map((p: any) => p.attributes ? p.attributes : p);
} catch (error) {
  console.error("Error loading featured posts:", error);
  // Fallback mock data matching your structural needs if fetch fails
  featuredPosts = [
    { title: "On the Typography of the Modern Web", excerpt: "An exploration into why editorial typefaces are reclaiming digital spaces from sterile sans-serif interfaces.", slug: "modern-web-typography", date: "2026-05-14" },
    { title: "Building Minimal Architectures with Astro", excerpt: "Breaking down how zero-JavaScript payloads keep web layouts incredibly performant and focused on pure content delivery.", slug: "minimal-astro-architecture", date: "2026-04-02" }
  ];
}

const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
};
---

<Layout title="Zayn Baig | Home">
  <main class="flex-1 h-[calc(100vh-64px)] md:h-screen overflow-y-auto px-8 sm:px-16 md:px-24 py-16 md:py-24 bg-background scroll-smooth">
    <div class="max-w-2xl mx-auto">
      
      <section class="flex items-center gap-6 sm:gap-8 mb-20">
        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-none overflow-hidden bg-foreground/5 border border-foreground/10 flex-shrink-0">
          <img src={absoluteImageUrl} alt="Zayn Baig" class="w-full h-full object-cover grayscale" />
        </div>
        <div>
          <h1 class="text-4xl font-serif font-black text-foreground tracking-tight mb-1.5">
            Zayn Baig
          </h1>
          <p class="text-base font-serif text-foreground/50 italic">
            Student, Creator, Thinker
          </p>
        </div>
      </section>

      <section class="w-full mb-24">
        <article 
          class="prose prose-sm sm:prose-base font-serif text-foreground/90 max-w-none text-justify leading-relaxed space-y-6
                 prose-a:text-primary prose-a:font-bold prose-a:underline prose-a:underline-offset-4 
                 hover:prose-a:text-highlight prose-a:transition-colors" 
          set:html={htmlBio} 
        />
      </section>

      {featuredPosts.length > 0 && (
        <section class="space-y-10">
          <h2 class="font-sans text-[11px] font-bold tracking-[0.25em] text-primary uppercase mb-8">
            Selected Writing
          </h2>
          
          <div class="space-y-12">
            {featuredPosts.map((post: any) => (
              <div class="group relative flex flex-col p-6 bg-foreground/[0.025] border-l-2 border-primary/40 transition-all duration-300 hover:bg-foreground/[0.04]">
                
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
                  <h3 class="text-lg font-serif font-black text-foreground leading-tight tracking-tight group-hover:text-primary transition-colors">
                    <a href={`/blog/${post.slug}`} class="focus:outline-none">
                      {post.title}
                    </a>
                  </h3>
                  <span class="font-sans text-[10px] font-bold tracking-wider text-foreground/40 uppercase whitespace-nowrap sm:text-right">
                    {formatDate(post.date || post.publishedAt)}
                  </span>
                </div>

                <p class="text-sm font-serif text-foreground/75 leading-relaxed text-justify mb-4">
                  {post.excerpt}
                </p>

                <div class="text-right">
                  <a 
                    href={`/blog/${post.slug}`} 
                    class="font-serif text-xs font-bold text-foreground/50 hover:text-primary tracking-wide transition-colors inline-flex items-center gap-1"
                  >
                    Read article <span class="text-[10px] font-sans tracking-tighter opacity-80">›››</span>
                  </a>
                </div>

              </div>
            ))}
          </div>

          <div class="text-center pt-4">
            <a 
              href="/blog" 
              class="font-sans text-[11px] font-bold tracking-widest text-foreground/40 hover:text-primary uppercase transition-colors inline-flex items-center gap-2"
            >
              View All Essays <span class="text-[10px] font-sans">›››</span>
            </a>
          </div>
        </section>
      )}

    </div>
  </main>
</Layout>

<style>
  /* Seamless Print Headings styling */
  article :global(h1) {
    font-family: Georgia, Cambria, "Times New Roman", Times, serif;
    font-size: 1.5rem;             
    font-weight: 900;              
    color: var(--color-foreground, #0c1618);
    letter-spacing: -0.025em;      
    margin-top: 2.5rem;              
    margin-bottom: 0.875rem;        
    display: block;
  }

  /* Clear Editorial Body Text Layout */
  article :global(p) {
    font-size: 0.935rem;           /* Bumped slightly for comfortable reading */
    line-height: 1.65;            
    margin-bottom: 1.25rem;        
    color: var(--color-foreground, #0c1618);
    opacity: 0.95;
  }

  /* High-Visibility Editorial Links Setup */
  article :global(a) {
    color: var(--color-primary, #66105c);      /* Uses your rich amethyst purple */
    font-weight: 700;                          /* Makes the link text bold */
    text-decoration: underline;
    text-underline-offset: 4px;                /* Adds premium breathing room beneath text */
    text-decoration-thickness: 1.5px;
    transition: color 0.2s ease-in-out;
  }

  /* Elegant Hover State Feedback Cue */
  article :global(a:hover) {
    color: var(--color-highlight, #22a39f);    /* Smoothly morphs into your seafoam cyan */
    text-decoration-color: var(--color-highlight, #22a39f);
  }
</style>
