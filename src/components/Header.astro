---
// frontend/src/components/Header.astro

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Experiences', href: '/academia' },
  { name: 'Projects', href: '/projects' },
  { name: 'Blog', href: '/blog' },
];

const pathname = Astro.url.pathname;
---

<header class="w-full bg-background border-b border-foreground/10 sticky top-0 z-50 backdrop-blur-md bg-background/90">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <a href="/" class="text-xl font-serif font-black text-foreground tracking-tight group flex items-center gap-2">
      <span class="w-2 h-2 rotate-45 bg-highlight transition-transform duration-300 group-hover:scale-125"></span>
      <span>Zayn Baig</span>
    </a>

    <nav class="hidden md:flex items-center gap-2">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        
        return (
          <a
            href={item.href}
            class={`px-4 py-2 font-serif text-sm tracking-wide transition-all duration-200 relative ${
              isActive
                ? 'font-black text-foreground underline decoration-highlight decoration-2 underline-offset-4'
                : 'text-foreground/60 hover:text-foreground font-medium'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <button 
      id="mobile-menu-toggle"
      class="md:hidden p-2 text-foreground/70 hover:bg-foreground/5 focus:outline-none"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div 
    id="mobile-menu" 
    class="hidden md:hidden w-full bg-background border-t border-foreground/10 absolute top-16 left-0 right-0 p-4 space-y-1 shadow-lg shadow-foreground/5"
  >
    {navItems.map((item) => {
      const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-4 py-3 font-serif text-base transition-colors ${
            isActive
              ? 'font-black text-foreground bg-foreground/5 border-l-2 border-highlight'
              : 'text-foreground/70 hover:bg-foreground/5'
          }`}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    
    if (menuIcon) {
      if (!isHidden) {
        menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      } else {
        menuIcon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    }
  });
</script>
