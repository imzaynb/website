---
// frontend/src/components/Navigation.astro

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Experiences', href: '/academia' },
  { name: 'Projects', href: '/projects' },
  { name: 'Writing', href: '/blog' },
];

const pathname = Astro.url.pathname;
---

<aside class="w-full md:w-64 lg:w-72 flex-shrink-0 bg-background border-b md:border-b-0 md:border-r border-foreground/10 sticky top-0 md:h-screen z-40">
  <div class="h-full flex flex-row md:flex-col items-center justify-between md:justify-center p-4 sm:p-6 md:p-12 gap-y-12">
    
    <a href="/" class="flex md:hidden items-center gap-2 font-serif font-black tracking-tight text-lg text-foreground">
      <span>Zayn Baig</span>
    </a>

    <nav class="flex flex-row md:flex-col items-center justify-end md:justify-center gap-x-5 sm:gap-x-6 md:gap-y-6 w-auto md:w-full">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        
        return (
          <a
            href={item.href}
            class={`text-sm sm:text-base font-serif tracking-wide transition-all duration-200 relative py-1 ${
              isActive 
                ? 'font-black text-foreground scale-105 underline decoration-highlight decoration-2 underline-offset-4' 
                : 'text-foreground/50 hover:text-foreground font-medium no-underline'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </nav>
    
    <div class="hidden md:block h-6 w-full"></div>
  </div>
</aside>
