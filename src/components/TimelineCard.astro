---
// frontend/src/components/TimelineCard.astro
import { marked } from 'marked';

interface Props {
  e: {
    title: string;
    organization: string;
    start_date: string;
    end_date: string | null;
    description: string;
    type: 'primary' | 'extracurricular';
  };
}

const { e } = Astro.props;

const rawDescription = e?.description || '';
const htmlDescription = marked.parse(rawDescription);

const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
};

const displayDate = `${formatDate(e?.start_date)} — ${e?.end_date ? formatDate(e.end_date) : 'Present'}`;
const isPrimary = e?.type === 'primary';
---

<div class="w-full">
  <div class={`flex flex-col p-6 sm:p-8 bg-foreground/[0.025] border-l-2 transition-all duration-300 hover:bg-foreground/[0.04] ${
    isPrimary ? 'border-highlight/40' : 'border-primary/40'
  }`}>
    
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-1.5">
      <h3 class="text-lg sm:text-xl font-serif font-black text-foreground leading-tight tracking-tight">
        {e.title}
      </h3>
      
      <span class="font-sans text-[11px] font-bold tracking-wider text-foreground/40 uppercase whitespace-nowrap sm:text-right">
        {displayDate}
      </span>
    </div>

    <p class="text-sm font-serif font-medium text-foreground/50 italic mb-4">
      {e.organization}
    </p>

    <article 
      class="prose prose-sm font-serif text-foreground/85 max-w-none text-justify text-sm leading-relaxed" 
      set:html={htmlDescription} 
    />
    
  </div>
</div>
